APP_NAME="HASSAL B2B Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Aden
APP_URL=https://marketplace.example.ye

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=ar,en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Target Database: MySQL 8.4 (Default Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hassal_production
DB_USERNAME=hassal_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=hassal_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.ye"
MAIL_FROM_NAME="${APP_NAME}"

# HASSAL Platform Business Defaults (Overridable via Dynamic System Settings)
PLATFORM_COUNTRY=YE
PLATFORM_DEFAULT_CURRENCY=YER
TAX_ENABLED=false
TAX_NAME="ضريبة المبيعات"
TAX_RATE=0.0000
TAX_INCLUSIVE=false
PLATFORM_COMMISSION_RATE=0.0250
PLATFORM_RESERVATION_TIMEOUT_MINUTES=30
PLATFORM_INSPECTION_WINDOW_HOURS=48

# Webhook & Idempotency
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10
IDEMPOTENCY_LIFETIME_HOURS=24
