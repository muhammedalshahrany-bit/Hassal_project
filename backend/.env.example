APP_NAME="HASSAL B2B Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Aden
APP_URL=https://marketplace.example.ye

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_SUPPORTED_LOCALES=ar,en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Target Database: MySQL 8.4 (Default Production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hassal_production
DB_USERNAME=hassal_app
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=hassal_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.ye"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HASSAL deployment wiring — the variables `config/hassal.php` actually reads.
#
# There is deliberately no PLATFORM_COUNTRY / PLATFORM_DEFAULT_CURRENCY /
# TAX_RATE / PLATFORM_COMMISSION_RATE here. Country, currency, tax, commission,
# reservation timeout and inspection window are operator data: they live in
# `system_settings`, are seeded by `php artisan app:install-system`, and are
# edited in the admin console. Setting them in .env would create a second,
# silent source of truth that a `config:cache` freezes.
# ---------------------------------------------------------------------------

# Declared by the release process. Until it is set, clients see a null version
# rather than a hard-coded "production" label the code invented.
HASSAL_APP_VERSION=
HASSAL_BRAND_NAME=HASSAL

# Public address of the web client. The backend's two browser-facing routes
# (the bare host and /reset-password/{token}) redirect here. Leave empty to
# fall back to APP_URL on a single-host deployment. Note that the emailed
# reset link is built from APP_URL and then redirects to this address.
HASSAL_FRONTEND_URL=http://localhost:3000

# Sanctum bearer-token lifetime (minutes). Every client must handle re-auth.
HASSAL_TOKEN_TTL_MINUTES=720
HASSAL_REMEMBER_ME_TTL_MINUTES=20160

# Geo discovery ceiling so a caller cannot ask the DB to haversine the planet.
HASSAL_GEO_DEFAULT_RADIUS_KM=100
HASSAL_GEO_MAX_RADIUS_KM=500

# Fallback hold duration and sweep grace period, used only while the
# `reservation.timeout` setting row is absent.
HASSAL_RESERVATION_TIMEOUT_MINUTES=30
HASSAL_RESERVATION_GRACE_SECONDS=60

# ---------------------------------------------------------------------------
# The first platform operator — `php artisan app:install-system` reads these.
#
# For an install with no terminal in front of it (a container entrypoint, a CI
# step). Leave them empty to be prompted instead: there is no default password
# in this repository for an installer to fall back to. Whatever is given here is
# hashed on its way into the `users` row and is never logged or echoed, so it is
# worth deleting these lines once the operator exists.
#
# This is the only account in the product that holds SuperAdmin. The sandbox
# demo seeder creates business users — owners, admins, staff, finance, auditors —
# and no second administrator: it reads the account above and never makes one.
# ---------------------------------------------------------------------------
HASSAL_ADMIN_NAME=
HASSAL_ADMIN_EMAIL=
HASSAL_ADMIN_PASSWORD=

# The shared sign-in for the demo accounts `php artisan db:seed
# --class=SandboxSeeder` creates. That seeder refuses to run without it, because
# a password the repository knows is a password nobody chose, and it refuses to
# run in production at all. Quoted here because a `#` inside an unquoted value
# would end the line.
#
# This password belongs to demo businesses on a development machine. It is the
# one credential in this file that is not a secret, and it is still worth
# deleting the line when the sandbox is no longer in use.
HASSAL_SANDBOX_PASSWORD=

# No payment, escrow or provider-adapter variables live here. HASSAL documents
# the trade and never carries money for it, so there is no provider to name.

# Webhook delivery. Keep private-endpoint access off: registering a webhook is
# an outbound POST from inside this network, so allowing internal addresses
# turns it into a request-forgery primitive. Never enable it on a public host.
HASSAL_WEBHOOK_ALLOW_PRIVATE_ENDPOINTS=false
HASSAL_WEBHOOK_TIMEOUT_SECONDS=10
HASSAL_WEBHOOK_MAX_ATTEMPTS=5
